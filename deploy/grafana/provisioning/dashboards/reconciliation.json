{
  "uid": "reconciliation",
  "title": "Reconciliation Service",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Events ingested (by source, outcome)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (source, outcome) (rate(recon_events_ingested_total[5m]))",
          "legendFormat": "{{source}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Dedup hit rate (rejected upserts)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(recon_events_ingested_total{outcome=\"rejected\"}[5m]))",
          "legendFormat": "dedup hits/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Worker failures (retrying vs dead-lettered)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(recon_worker_failures_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Reconcile pass duration (p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(recon_reconcile_duration_seconds_bucket[15m])))",
          "legendFormat": "p95 seconds"
        }
      ]
    },
    {
      "id": 5,
      "title": "Events by status",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "recon_events_by_status",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Events by reconciliation status",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "recon_events_by_recon_status",
          "legendFormat": "{{recon_status}}"
        }
      ]
    }
  ]
}
