# Copy to .env and fill in. .env is gitignored.
# See docs/ENVIRONMENT.md. NEVER put SSG production credentials here —
# use PayPal sandbox and a personal Ticket Tailor account (CLAUDE.md guardrail 4).

PORT=8080

# Postgres — the worker's role, which writes.
DATABASE_URL=postgres://reconciler:reconciler@localhost:5432/reconciliation?sslmode=disable

# The query API's role. MUST be SELECT-only: see deploy/readonly-role.sql.
# cmd/server proves this at startup and refuses to serve if the role can write.
API_DATABASE_URL=postgres://reconciliation_api:CHANGEME@localhost:5432/reconciliation?sslmode=disable

# One key per consumer, so a single caller can be revoked without rotating
# everyone. Minimum 24 characters. Generate with: openssl rand -base64 32
API_KEYS=dashboard:CHANGEME-at-least-24-characters

# Ticket Tailor — personal test account only
TT_API_KEY=
TT_WEBHOOK_SECRET=

# PayPal — sandbox app only.
# Leave PAYPAL_SANDBOX unset or true. Setting it false points at SSG's live
# account and is forbidden in development.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=true

# Absolute path OUTSIDE this repository. Holds live historical data with buyer
# PII; it must never live inside the tree.
SSG_PARITY_DATA=
