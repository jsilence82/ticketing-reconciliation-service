# Copy to .env and fill in. .env is gitignored.
# See docs/ENVIRONMENT.md. NEVER put SSG production credentials here —
# use PayPal sandbox and a personal Ticket Tailor account (CLAUDE.md guardrail 4).

PORT=8080

# Postgres (P3+)
DATABASE_URL=postgres://reconciler:reconciler@localhost:5432/reconciliation?sslmode=disable

# Ticket Tailor — personal test account only
TT_API_KEY=
TT_WEBHOOK_SECRET=

# PayPal — sandbox app only.
# Leave PAYPAL_SANDBOX unset or true. Setting it false points at SSG's live
# account and is forbidden in development.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=true

# Absolute path OUTSIDE this repository. Holds live historical data with buyer
# PII; it must never live inside the tree.
SSG_PARITY_DATA=
